<?xml version="1.0" encoding="utf-8"?>
<!-- The splash's icon at rest, the last frame of splash_icon.xml. Android 12+ draws the animated icon
     in a 288 dp canvas of which the middle 192 dp circle shows; the mark is the app icon's mark at
     1.5 times the size of its 100-unit space, centred, and the lamp's glow fades out inside the circle.
     scripts/render-assets.mjs draws the same frame as drawable-*/splash.png (the launcher's own
     splash view and Chrome's keep it on screen after the system's), so keep the numbers in step. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp" android:height="288dp"
    android:viewportWidth="288" android:viewportHeight="288">
    <path android:name="glow" android:pathData="M0 0H288V288H0Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="144" android:centerY="134.6" android:gradientRadius="90">
                <item android:offset="0" android:color="#66efb768" />
                <item android:offset="0.4" android:color="#24efb768" />
                <item android:offset="1" android:color="#00efb768" />
            </gradient>
        </aapt:attr>
    </path>
    <group android:translateX="69" android:translateY="52.125" android:scaleX="1.5" android:scaleY="1.5">
        <group android:name="sky">
            <clip-path android:pathData="M0 0H100V58H90C74 52 58 54 50 66C42 54 26 52 10 58H0Z" />
            <group android:name="sun">
                <path android:fillColor="#efb768" android:pathData="M50 36.5A18.5 18.5 0 1 1 50 73.5A18.5 18.5 0 1 1 50 36.5Z" />
            </group>
        </group>
        <group android:name="pages">
            <path android:name="pagesFill" android:fillColor="#f1e3c8" android:pathData="M48.4 70C42 58 26 56 10 62V78C26 72 42 74 48.4 86ZM51.6 70C58 58 74 56 90 62V78C74 72 58 74 51.6 86Z" />
        </group>
    </group>
</vector>
