<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the system's splash screen. The night room, and the mark as an animated vector
     (drawable/splash_icon.xml): the pages arrive and the lamp rises behind them. The system
     allows an icon animation of 1000 ms at most; from Android 13 it reads the length from the
     animation itself and ignores windowSplashScreenAnimationDuration, which is set for 12. -->
<resources>
    <style name="LauncherTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:windowSplashScreenBackground">@color/night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
</resources>
