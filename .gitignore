node_modules/
.env
.env.*
!.env.example
.DS_Store

# Claude Code worktrees and local agent state
.claude/
.commandcode/
.wrangler/
.pi/subagent-schedules/

# web/pnpm-workspace.yaml is committed: it approves dependency build scripts
# for pnpm 11+ (web/AGENTS.md, gotchas). design/ has none to approve.
design/pnpm-workspace.yaml

# Web — Nuxt build output and Playwright artifacts. `web/dist` is a symlink
# that `nuxt generate` creates, so no trailing slash: a slash would only match
# a directory.
web/.nuxt/
web/.output/
# The Playwright flows' build (LIBELLUS_E2E=1, web/e2e/build.ts).
web/.output-e2e/
web/dist
web/test-results/
web/playwright-report/
# `npx wrangler pages dev dist` keeps its local state here (docs/HOSTING.md).
web/.wrangler/
web/blob-report/
web/all-blob-reports/

# Local data the scripts write: the Fable import's cover cache and report
# (web/scripts/import-fable.ts). Real reading history: never committed.
.data/

# Email preview renders (`pnpm email:preview` in web/): screenshots of the templates.
web/.email-preview/

# i18n dry-run output (web/scripts/i18n/sample.mjs): scratch translations, never committed.
web/.i18n-sample/

# Screenshots and videos a proof script writes (web/perf/shelf.ts): looked at, never committed.
/.shots/

# Android (docs/ANDROID.md): Gradle state, node_modules and build output, and never a signing key.
# The keystore lives in ~/.android-keys/; these patterns catch one copied into the repo by mistake.
android/.gradle/
android/build/
android/app/build/
android/node_modules/
android/local.properties
android/.idea/
android/app-release-*
*.jks
*.keystore
*.p12
*.pk8
*.apk
*.aab
*.idsig
