    "collections.pickerTitle", "genre.sheet.title", "genre.sheet.hint", "ownEdition.title.isbn",
    "feed.emptyTitle", "feed.empty", "library.segmentEmpty.finished.title", "collection.missingTitle",
    "book.progress.percent", "reader.where", "common.today", "import.howTo.goodreads", "home.installHint.text",
    "privacy.goPublicText", "shelf.card.allLabel", "waitlist.code.not_configured", "friends.join", "friends.and"
