    "placeholders": ["home.readInLabel", "collection.moved", "friends.declineLabel", "feed.batchFinished", "common.today", "reader.where", "book.progress.percent"],
    "slot (i18n-t) and glue": ["book.goodreads.on", "friends.want", "friends.join", "friends.and"],
    "linked @:": ["sample.linked", "sample.linkedPlural"],
    "literal {'@'}": ["signIn.emailPlaceholder"],
    "long sentence": ["sync.waiting", "photo.private", "sharing.about", "privacy.goPublicText", "home.installHint.text", "waitlist.code.not_configured", "import.howTo.goodreads"],
    "error": ["auth.error.invite_gone", "library.error.ended_before_started", "home.loadError", "waitlist.code.not_configured"],
    "sheet title and hint": ["collections.pickerTitle", "genre.sheet.title", "genre.sheet.hint", "ownEdition.title.isbn"],
    "empty state": ["feed.emptyTitle", "feed.empty", "library.segmentEmpty.finished.title", "collection.missingTitle"]
  }
