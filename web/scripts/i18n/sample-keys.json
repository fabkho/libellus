  "kinds": {
    "plain label": ["common.cancel", "status.want_to_read", "status.reading", "status.finished", "status.notFinished", "rating.none", "profile.account.signOut", "profile.account.delete", "library.view.sortDir.pages.desc", "genre.crime"],
