# Copy to .env (gitignored). Both values are public: the anon key only grants
# what RLS allows. Never put the service_role key here; it bypasses RLS.
#
# Local stack (`supabase start` in the repo root) prints the anon key, or ask
# `supabase status -o env`. The libellus stack listens on 553xx, not 543xx.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Everything below is optional; docs/SETUP.md has the full table.
#
# Book links every member of this instance sees on a Book's page, before her own (Profile →
# Book links). JSON; placeholders {isbn} {isbn10} {title} {author}, filled URL-encoded. Public:
# it is part of the built files, so put nothing here you would not publish.
# NUXT_PUBLIC_LINK_TEMPLATES=[{"label":"Open Library","url":"https://openlibrary.org/isbn/{isbn}"}]
#
# The owner's 3D shelf (Regal, a private Nuxt layer): off unless LIBELLUS_REGAL=1.
# LIBELLUS_REGAL=1
# REGAL_LAYER=/path/to/regal          # or GIGET_AUTH=<token that can read fabkho/regal>
# NUXT_PUBLIC_REGAL_LIBRARY_SRC=https://…/v2/library.json
# NUXT_PUBLIC_SHELF_OWNER_ID=<the owner's auth user id>
#
# The client error log (docs/OPERATIONS.md). A build sends the errors it meets to the database
# unless this is `off`; the dev server only prints them, and sends them to the stack with `send`.
# NUXT_PUBLIC_ERROR_LOG=
