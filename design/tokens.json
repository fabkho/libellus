{
  "color": {
    "$description": "Neutral placeholders until the design round (#4/#5) picks the palette. Roles, not hues: screens only ever name the role.",
    "surface":       { "$type": "color", "$value": "#FAFAF9" },
    "surfaceRaised": { "$type": "color", "$value": "#FFFFFF" },
    "surfaceSunken": { "$type": "color", "$value": "#F0EFED" },
    "ink":           { "$type": "color", "$value": "#1C1B1A" },
    "inkMuted":      { "$type": "color", "$value": "#57534E" },
    "inkFaint":      { "$type": "color", "$value": "#8A847D" },
    "outline":       { "$type": "color", "$value": "#D6D3D1" },
    "accent":        { "$type": "color", "$value": "#3F3F46" },
    "onAccent":      { "$type": "color", "$value": "#FFFFFF" },
    "success":       { "$type": "color", "$value": "#3F6212" },
    "error":         { "$type": "color", "$value": "#B91C1C" },
    "errorSoft":     { "$type": "color", "$value": "#FEE2E2" }
  },
  "space": {
    "xs":     { "$type": "number", "$value": 4 },
    "sm":     { "$type": "number", "$value": 8 },
    "md":     { "$type": "number", "$value": 16 },
    "lg":     { "$type": "number", "$value": 24 },
    "xl":     { "$type": "number", "$value": 32 },
    "xxl":    { "$type": "number", "$value": 48 },
    "screen": { "$type": "number", "$value": 20, "$description": "Horizontal padding of a screen, outside the safe-area inset." }
  },
  "radius": {
    "sm":   { "$type": "number", "$value": 6 },
    "md":   { "$type": "number", "$value": 12 },
    "lg":   { "$type": "number", "$value": 20 },
    "pill": { "$type": "number", "$value": 999 }
  },
  "size": {
    "touch":      { "$type": "number", "$value": 44, "$description": "Smallest touch target." },
    "maxContent": { "$type": "number", "$value": 600 }
  },
  "stroke": {
    "hairline": { "$type": "number", "$value": 1 },
    "focus":    { "$type": "number", "$value": 2 }
  },
  "fontFamily": {
    "$description": "Inter as a neutral placeholder, latin subset via Fontsource; replaced after the design round.",
    "sans": { "$type": "fontFamily", "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] }
  },
  "fontSize": {
    "display": { "$type": "number", "$value": 34 },
    "title":   { "$type": "number", "$value": 24 },
    "body":    { "$type": "number", "$value": 17 },
    "label":   { "$type": "number", "$value": 15 },
    "caption": { "$type": "number", "$value": 13 }
  },
  "lineHeight": {
    "display": { "$type": "number", "$value": 40 },
    "title":   { "$type": "number", "$value": 30 },
    "body":    { "$type": "number", "$value": 24 },
    "label":   { "$type": "number", "$value": 20 },
    "caption": { "$type": "number", "$value": 18 }
  },
  "letterSpacing": {
    "display": { "$type": "number", "$value": -0.4 }
  },
  "duration": {
    "$description": "Milliseconds. docs/MOTION.md is the only source of durations once it is written.",
    "quick":    { "$type": "number", "$value": 150 },
    "standard": { "$type": "number", "$value": 250 },
    "exit":     { "$type": "number", "$value": 200 }
  }
}
