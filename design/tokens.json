{
  "color": {
    "$description": "Direction D \"Night Reader\" (#4): a reading lamp in a dark room. Two themes, light (D's Day) and dark (D's Night). Roles, not hues: screens only ever name the role, and every role has a value per theme.",
    "surface":        { "$type": "color", "$value": { "light": "#f4f0e9", "dark": "#0e0c0a" }, "$description": "The room: page background." },
    "surfaceRaised":  { "$type": "color", "$value": { "light": "#fbf9f5", "dark": "#171512" }, "$description": "Cards, the search palette, the avatar menu." },
    "surfaceSheet":   { "$type": "color", "$value": { "light": "#fbf9f5", "dark": "#1b1815" }, "$description": "Bottom sheets." },
    "surfaceStage":   { "$type": "color", "$value": { "light": "#1a1714", "dark": "#000000" }, "$description": "Behind a page that steps back under a sheet." },
    "glass":          { "$type": "color", "$value": { "light": "rgb(251 249 245 / 0.78)", "dark": "rgb(28 25 22 / 0.72)" }, "$description": "Floating chrome over content (tab bar, round buttons), always with backdrop blur." },
    "fill":           { "$type": "color", "$value": { "light": "rgb(40 30 20 / 0.05)", "dark": "rgb(255 238 214 / 0.055)" }, "$description": "A quiet tint: grouped rows, the avatar, code cells." },
    "fillStrong":     { "$type": "color", "$value": { "light": "rgb(40 30 20 / 0.085)", "dark": "rgb(255 238 214 / 0.1)" }, "$description": "Quiet buttons, pressed rows." },
    "hairline":       { "$type": "color", "$value": { "light": "rgb(40 30 20 / 0.1)", "dark": "rgb(255 236 210 / 0.085)" }, "$description": "Dividers and card edges." },
    "hairlineStrong": { "$type": "color", "$value": { "light": "rgb(40 30 20 / 0.17)", "dark": "rgb(255 236 210 / 0.16)" }, "$description": "Edges of floating chrome, row dividers inside a group, outlines." },
    "ink":            { "$type": "color", "$value": { "light": "#1c1915", "dark": "#eee7dc" }, "$description": "Primary text and icons; the primary button's fill." },
    "inkMuted":       { "$type": "color", "$value": { "light": "rgb(28 25 21 / 0.64)", "dark": "rgb(238 231 220 / 0.64)" }, "$description": "Secondary text." },
    "inkFaint":       { "$type": "color", "$value": { "light": "rgb(28 25 21 / 0.45)", "dark": "rgb(238 231 220 / 0.42)" }, "$description": "Authors, meta lines, eyebrows, inactive tabs." },
    "inkGhost":       { "$type": "color", "$value": { "light": "rgb(28 25 21 / 0.2)", "dark": "rgb(238 231 220 / 0.2)" }, "$description": "Placeholders, chevrons, the grabber, disabled text." },
    "onInk":          { "$type": "color", "$value": { "light": "#f8f5ef", "dark": "#0e0c0a" }, "$description": "Text on an ink fill (the primary button)." },
    "accent":         { "$type": "color", "$value": { "light": "#b8782a", "dark": "#efb768" }, "$description": "The lamp. Used sparingly: the active tab dot, the focused field rule, the sheet's action, carets, stars." },
    "accentSoft":     { "$type": "color", "$value": { "light": "rgb(184 120 42 / 0.12)", "dark": "rgb(239 183 104 / 0.14)" }, "$description": "A lamp-tinted wash: focus halos, the selected row." },
    "lampLight":      { "$type": "color", "$value": { "light": "rgb(239 183 104 / 0.16)", "dark": "rgb(239 183 104 / 0.14)" }, "$description": "The pool of light in empty states and the light cone of the lamp drawing." },
    "lampCone":       { "$type": "color", "$value": "rgb(239 183 104 / 0.22)", "$description": "Where the light cone of the lamp drawing starts; it fades to nothing." },
    "lampGlow":       { "$type": "color", "$value": { "light": "rgb(255 255 255 / 0.5)", "dark": "rgb(239 183 104 / 0.18)" }, "$description": "The glow behind the wordmark on the way in." },
    "star":           { "$type": "color", "$value": { "light": "#b8782a", "dark": "#efb768" }, "$description": "The filled part of a rating star." },
    "starTrack":      { "$type": "color", "$value": { "light": "rgb(28 25 21 / 0.2)", "dark": "rgb(238 231 220 / 0.2)" }, "$description": "The empty part of a rating star." },
    "success":        { "$type": "color", "$value": { "light": "#4f7a3c", "dark": "#a3c48e" }, "$description": "Confirmations." },
    "error":          { "$type": "color", "$value": { "light": "#c2452a", "dark": "#ec8063" }, "$description": "Errors and destructive actions." },
    "errorSoft":      { "$type": "color", "$value": { "light": "rgb(194 69 42 / 0.1)", "dark": "rgb(236 128 99 / 0.12)" }, "$description": "Background of an error block." },
    "scrim":          { "$type": "color", "$value": { "light": "rgb(26 20 14 / 0.38)", "dark": "rgb(0 0 0 / 0.5)" }, "$description": "Behind a sheet." },
    "veil":           { "$type": "color", "$value": { "light": "rgb(244 240 233 / 0.55)", "dark": "rgb(14 12 10 / 0.55)" }, "$description": "Over the blurred page behind the search palette." },
    "cloth1":         { "$type": "color", "$value": "#3b2430", "$description": "Placeholder cover cloths, picked by title. The same in both themes: a cover is an object, not chrome." },
    "cloth2":         { "$type": "color", "$value": "#22303f" },
    "cloth3":         { "$type": "color", "$value": "#2c3a2e" },
    "cloth4":         { "$type": "color", "$value": "#4a3220" },
    "cloth5":         { "$type": "color", "$value": "#30293f" },
    "cloth6":         { "$type": "color", "$value": "#4a2624" },
    "clothInk":       { "$type": "color", "$value": "#f1e3c8", "$description": "Type and rules on a Placeholder cover." }
  },
  "shadow": {
    "$description": "Box shadows, one per theme: warm and light on paper, deep in the dark room. CSS strings; a native port reads the intent from docs/DESIGN.md.",
    "raised":  { "$type": "shadow", "$value": { "light": "inset 0 1px 0 rgb(255 255 255 / 0.6), 0 14px 34px rgb(60 40 20 / 0.14)", "dark": "inset 0 1px 0 rgb(255 255 255 / 0.04), 0 18px 40px rgb(0 0 0 / 0.5)" } },
    "cover":   { "$type": "shadow", "$value": { "light": "0 10px 24px rgb(60 40 20 / 0.22), 0 2px 5px rgb(60 40 20 / 0.18)", "dark": "0 10px 28px rgb(0 0 0 / 0.55), 0 2px 6px rgb(0 0 0 / 0.5)" } },
    "float":   { "$type": "shadow", "$value": { "light": "0 12px 30px rgb(60 40 20 / 0.18)", "dark": "0 12px 30px rgb(0 0 0 / 0.35)" }, "$description": "The tab bar capsule." },
    "button":  { "$type": "shadow", "$value": { "light": "0 6px 18px rgb(60 40 20 / 0.22)", "dark": "0 6px 18px rgb(0 0 0 / 0.25)" }, "$description": "The primary button." },
    "palette": { "$type": "shadow", "$value": { "light": "0 -10px 50px rgb(60 40 20 / 0.14), 0 12px 30px rgb(60 40 20 / 0.18)", "dark": "0 -10px 50px rgb(0 0 0 / 0.4), 0 12px 30px rgb(0 0 0 / 0.35)" }, "$description": "The search palette and the avatar menu." },
    "sheet":   { "$type": "shadow", "$value": { "light": "0 -20px 50px rgb(60 40 20 / 0.16)", "dark": "0 -20px 50px rgb(0 0 0 / 0.4)" } }
  },
  "opacity": {
    "glow": { "$type": "number", "$value": { "light": 0.5, "dark": 1 }, "$description": "How strongly a cover lights its card or page. Half on paper." },
    "halo": { "$type": "number", "$value": { "light": 0.4, "dark": 0.45 }, "$description": "The blurred copy of a cover behind it." }
  },
  "blur": {
    "glass":  { "$type": "number", "$value": 22, "$description": "Backdrop of the tab bar and the avatar menu." },
    "chrome": { "$type": "number", "$value": 18, "$description": "Backdrop of round glass buttons." },
    "veil":   { "$type": "number", "$value": 7, "$description": "The page behind the search palette." },
    "halo":   { "$type": "number", "$value": 26, "$description": "A cover's halo." }
  },
  "space": {
    "xxs":    { "$type": "number", "$value": 2 },
    "xs":     { "$type": "number", "$value": 4 },
    "sm":     { "$type": "number", "$value": 8 },
    "bar":    { "$type": "number", "$value": 10, "$description": "Above and below a large title, under the 44 pt controls row (iOS Large Title)." },
    "ms":     { "$type": "number", "$value": 12 },
    "inset":  { "$type": "number", "$value": 14, "$description": "Inner padding of rows and cards." },
    "md":     { "$type": "number", "$value": 16 },
    "ml":     { "$type": "number", "$value": 20 },
    "lg":     { "$type": "number", "$value": 24 },
    "xl":     { "$type": "number", "$value": 32 },
    "xxl":    { "$type": "number", "$value": 48 },
    "xxxl":   { "$type": "number", "$value": 64 },
    "screen": { "$type": "number", "$value": 20, "$description": "Horizontal padding of a screen, outside the safe-area inset." },
    "tabBarDrop": { "$type": "number", "$value": 13, "$description": "How far the tab bar and the search palette sit into the home-indicator inset: 34 − 13 = 21 pt off the screen edge on Face ID iPhones, as iOS 26 places its tab bar." }
  },
  "radius": {
    "coverSm": { "$type": "number", "$value": 2.5, "$description": "Covers under 60 px wide." },
    "cover":   { "$type": "number", "$value": 3.5, "$description": "Covers 60–99 px wide." },
    "coverLg": { "$type": "number", "$value": 5, "$description": "Covers 100 px wide and more." },
    "sm":      { "$type": "number", "$value": 8 },
    "md":      { "$type": "number", "$value": 14, "$description": "Grouped rows, code cells." },
    "field":   { "$type": "number", "$value": 18, "$description": "The search field and the avatar menu." },
    "lg":      { "$type": "number", "$value": 20, "$description": "Cards." },
    "xl":      { "$type": "number", "$value": 24, "$description": "The search palette." },
    "sheet":   { "$type": "number", "$value": 30, "$description": "The top corners of a bottom sheet." },
    "pill":    { "$type": "number", "$value": 999 }
  },
  "size": {
    "touch":      { "$type": "number", "$value": 44, "$description": "Smallest touch target." },
    "maxContent": { "$type": "number", "$value": 480, "$description": "The column the phone layout sits in on a wide screen." },
    "avatar":     { "$type": "number", "$value": 32 },
    "tab":        { "$type": "number", "$value": 72, "$description": "Width of one tab in the capsule (iOS 26 minimum): three tabs and the glass padding make a 224 pt capsule." },
    "tabBar":     { "$type": "number", "$value": 62, "$description": "Height of the tab bar capsule: iOS 26's 54 pt row and 4 pt of glass above and below." },
    "tabIcon":    { "$type": "number", "$value": 26, "$description": "The tab bar's icons; the lamp dot sits 6 under them." },
    "button":     { "$type": "number", "$value": 50, "$description": "Height of a large button." },
    "buttonMd":   { "$type": "number", "$value": 40 },
    "buttonSm":   { "$type": "number", "$value": 32 },
    "row":        { "$type": "number", "$value": 48, "$description": "A row in a group." },
    "query":      { "$type": "number", "$value": 62, "$description": "The query row of the search palette: as tall as the capsule it grows out of." },
    "menu":       { "$type": "number", "$value": 272, "$description": "Width of the avatar menu." },
    "switch":     { "$type": "number", "$value": 40, "$description": "Width of a switch track." },
    "switchThumb": { "$type": "number", "$value": 20, "$description": "The switch's knob; the track is this plus 2 px around." },
    "grabber":    { "$type": "number", "$value": 36, "$description": "Width of a sheet's grabber." },
    "emptyArt":   { "$type": "number", "$value": 250, "$description": "Height of the lamp drawing in empty states." },
    "fade":       { "$type": "number", "$value": 138, "$description": "Height of the fade under the tab bar, from the screen edge: 64 above the capsule where there is no home indicator." },
    "starSm":     { "$type": "number", "$value": 12, "$description": "Rating stars: in lists." },
    "star":       { "$type": "number", "$value": 16, "$description": "Rating stars: on cards." },
    "starLg":     { "$type": "number", "$value": 24, "$description": "Rating stars: book detail." },
    "starInput":  { "$type": "number", "$value": 44, "$description": "Rating stars in the rating control (Finish sheet): one star per fingertip." },
    "ratingThumb": { "$type": "number", "$value": 24, "$description": "The rating control's thumb on its rail of quarter notches." },
    "coverXs":    { "$type": "number", "$value": 30, "$description": "Cover widths: book line in a sheet." },
    "coverSm":    { "$type": "number", "$value": 40, "$description": "List rows and search results." },
    "coverMd":    { "$type": "number", "$value": 72, "$description": "Shelves (Up next)." },
    "coverLg":    { "$type": "number", "$value": 82, "$description": "Currently reading cards." },
    "coverXl":    { "$type": "number", "$value": 140, "$description": "Book detail." }
  },
  "stroke": {
    "hairline": { "$type": "number", "$value": 0.5, "$description": "Edges of chrome, dividers." },
    "rule":     { "$type": "number", "$value": 1, "$description": "The underline of a text field." },
    "focus":    { "$type": "number", "$value": 2 },
    "icon":     { "$type": "number", "$value": 1.5, "$description": "Icon strokes on the 24 px grid." },
    "iconBold": { "$type": "number", "$value": 1.7, "$description": "The active tab's icon." }
  },
  "fontFamily": {
    "$description": "Latin subsets via Fontsource. Geist for the interface, Geist Mono for figures, dates and eyebrows, Newsreader for book titles and the wordmark.",
    "sans":  { "$type": "fontFamily", "$value": ["Geist", "-apple-system", "system-ui", "sans-serif"] },
    "mono":  { "$type": "fontFamily", "$value": ["Geist Mono", "ui-monospace", "monospace"] },
    "serif": { "$type": "fontFamily", "$value": ["Newsreader", "Georgia", "serif"] }
  },
  "fontWeight": {
    "light":    { "$type": "fontWeight", "$value": 300, "$description": "Large figures only." },
    "regular":  { "$type": "fontWeight", "$value": 400 },
    "medium":   { "$type": "fontWeight", "$value": 500, "$description": "Titles, buttons, book titles." },
    "semibold": { "$type": "fontWeight", "$value": 600, "$description": "Sheet titles." }
  },
  "text": {
    "$description": "The type scale. Size and line height in px (emitted as rem, so type follows the browser's text size), tracking in em. The family is a separate choice (font-serif for book titles).",
    "wordmark":   { "$type": "typography", "$value": { "fontSize": 54,   "lineHeight": 54, "letterSpacing": -0.02 },  "$description": "Libellus on the way in. Serif italic." },
    "figure":     { "$type": "typography", "$value": { "fontSize": 44,   "lineHeight": 44, "letterSpacing": -0.04, "fontWeight": 300 }, "$description": "A large count (Read in <year>)." },
    "largeTitle": { "$type": "typography", "$value": { "fontSize": 28,   "lineHeight": 34, "letterSpacing": -0.03, "fontWeight": 500 }, "$description": "A tab's title (Library)." },
    "title":      { "$type": "typography", "$value": { "fontSize": 24,   "lineHeight": 27, "letterSpacing": -0.025, "fontWeight": 500 }, "$description": "Home's title under its date." },
    "headline":   { "$type": "typography", "$value": { "fontSize": 24,   "lineHeight": 29, "letterSpacing": -0.01, "fontWeight": 500 }, "$description": "Empty-state titles, book detail title. Serif." },
    "bookTitle":  { "$type": "typography", "$value": { "fontSize": 21,   "lineHeight": 24, "letterSpacing": -0.01, "fontWeight": 500 }, "$description": "A book title on a card. Serif." },
    "input":      { "$type": "typography", "$value": { "fontSize": 19,   "lineHeight": 24, "letterSpacing": -0.015 }, "$description": "What the member types into a form field." },
    "callout":    { "$type": "typography", "$value": { "fontSize": 17,   "lineHeight": 22, "letterSpacing": -0.015 }, "$description": "The search query; a list book title (serif)." },
    "bodyLarge":  { "$type": "typography", "$value": { "fontSize": 16,   "lineHeight": 22, "letterSpacing": -0.01 }, "$description": "Large buttons, the search prompt." },
    "body":       { "$type": "typography", "$value": { "fontSize": 15,   "lineHeight": 20, "letterSpacing": -0.005 }, "$description": "The default." },
    "subhead":    { "$type": "typography", "$value": { "fontSize": 14.5, "lineHeight": 21, "letterSpacing": -0.005 }, "$description": "Empty-state text, medium buttons." },
    "caption":    { "$type": "typography", "$value": { "fontSize": 13,   "lineHeight": 18, "letterSpacing": 0 }, "$description": "Authors, hints, small buttons." },
    "footnote":   { "$type": "typography", "$value": { "fontSize": 12.5, "lineHeight": 16, "letterSpacing": 0 }, "$description": "Field labels, errors." },
    "meta":       { "$type": "typography", "$value": { "fontSize": 11,   "lineHeight": 14, "letterSpacing": 0 }, "$description": "Mono meta lines (dates, counts, a rating value), avatar initials." },
    "eyebrow":    { "$type": "typography", "$value": { "fontSize": 10.5, "lineHeight": 12, "letterSpacing": 0.12, "fontWeight": 500 }, "$description": "Mono, uppercase section labels." }
  },
  "duration": {
    "$description": "Milliseconds. docs/MOTION.md says where each one is used; no other duration is written anywhere.",
    "instant":     { "$type": "duration", "$value": 100, "$description": "Press feedback." },
    "quick":       { "$type": "duration", "$value": 150, "$description": "Small state changes: a tab lighting up, a switch." },
    "standard":    { "$type": "duration", "$value": 250, "$description": "Crossfades, the avatar menu." },
    "exit":        { "$type": "duration", "$value": 200, "$description": "Anything leaving." },
    "sheet":       { "$type": "duration", "$value": 380, "$description": "A sheet rising." },
    "sheetExit":   { "$type": "duration", "$value": 260, "$description": "A sheet falling away." },
    "overlay":     { "$type": "duration", "$value": 340, "$description": "The tab bar morphing into the search palette." },
    "overlayExit": { "$type": "duration", "$value": 240, "$description": "The search palette morphing back into the tab bar." },
    "keyboard":    { "$type": "duration", "$value": 250, "$description": "The iOS keyboard rising or falling (UIKeyboardAnimationDurationUserInfoKey); the palette rides along." },
    "caret":       { "$type": "duration", "$value": 1100, "$description": "One blink cycle of a drawn caret." }
  },
  "easing": {
    "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1], "$description": "Things arriving: fast out of the gate, a long soft landing." },
    "exit":     { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1], "$description": "Things leaving: accelerate away." },
    "sheet":    { "$type": "cubicBezier", "$value": [0.32, 0.72, 0, 1], "$description": "Sheets and the palette, the iOS sheet curve." },
    "keyboard": { "$type": "cubicBezier", "$value": [0.1, 0.76, 0.55, 0.9], "$description": "An approximation of the iOS keyboard's own curve (an overdamped spring), for whatever moves with it." }
  }
}
